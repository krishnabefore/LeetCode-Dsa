class Solution {
public:
    int titleToNumber(string columnTitle) {
        int num  = 0;
      
        for(int i = 0; i < columnTitle.length() ; i++){
            char ch = columnTitle[i];
            int value = ch - 'A' + 1;
            num = num*26 + value;
        }
            
        return num;
    }
};
