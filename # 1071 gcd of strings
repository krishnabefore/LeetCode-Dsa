
#include<numeric>
class Solution {
public:
    string gcdOfStrings(string str1, string str2) {
   string x = "";
   
   // y is length of x
   if(str2 + str1 == str1 + str2){
    int y  = gcd(str1.length() , str2.length() );
     x = str2.substr(0 ,  y);
   }

   else {
    return "";
   }
    
   return x; 
    }
};
